<?xml version="1.0" encoding="utf-8"?>
<!-- Repository NuGet settings: ignore machine-wide package sources (a missing/offline source makes restore fail).
     Core projects use no packages; nuget.org is only needed for the win-x64 runtime packs when publishing self-contained. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>
