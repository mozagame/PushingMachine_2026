<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CheckBarcode.Wpf</RootNamespace>
    <AssemblyName>CheckBarcode</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <StartupObject>CheckBarcode.Wpf.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Views are built in C# (no XAML compiler needed), see docs/ARCHITECTURE.md. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\CheckBarcode.Infrastructure\CheckBarcode.Infrastructure.csproj" />
    <ProjectReference Include="..\CheckBarcode.Simulation\CheckBarcode.Simulation.csproj" />
    <ProjectReference Include="..\CheckBarcode.Devices.Cognex\CheckBarcode.Devices.Cognex.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\config\**\*" LinkBase="config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\lib\native\SQLite.Interop.dll" Link="SQLite.Interop.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
